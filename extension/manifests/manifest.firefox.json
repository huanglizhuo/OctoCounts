{
  "manifest_version": 3,
  "name": "OctoCounts — GitHub SLOC",
  "version": "0.1.0",
  "description": "Shows source lines of code on GitHub repo pages",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon":  "icons/icon48.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [{
    "matches": ["https://github.com/*/*"],
    "js":      ["content.js"],
    "run_at":  "document_end"
  }],
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://github.com/*",
    "https://api.octocounts.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon128.png"],
      "matches": ["https://github.com/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "octocount@octocounts.com",
      "strict_min_version": "121.0"
    }
  }
}
