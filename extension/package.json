{
  "name": "octocount-extension",
  "version": "0.1.3",
  "private": true,
  "scripts": {
    "build:chrome":  "vite build --config vite.config.js --mode chrome",
    "build:firefox": "vite build --config vite.config.js --mode firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "dev": "vite build --config vite.config.js --mode chrome --watch"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "webextension-polyfill": "^0.12.0"
  }
}
