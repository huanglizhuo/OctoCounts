{
  "name": "octocount-extension",
  "version": "0.4.2",
  "private": true,
  "scripts": {
    "build:chrome": "vite build --config vite.config.js --mode chrome",
    "build:edge": "vite build --config vite.config.js --mode edge",
    "build:firefox": "vite build --config vite.config.js --mode firefox",
    "build:all": "npm run build:chrome && npm run build:edge && npm run build:firefox",
    "build": "npm run build:all",
    "test": "npm run test:unit && npm run build:all && node --test tests/build-artifacts.test.mjs",
    "test:unit": "node --test tests/github-dom.test.mjs",
    "package:artifacts": "npm run build:all && node scripts/package-artifacts.mjs",
    "package:release": "npm run build:all && node scripts/package-artifacts.mjs --release",
    "dev": "vite build --config vite.config.js --mode chrome --watch",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "linkedom": "^0.18.13",
    "vite": "^6.0.0",
    "webextension-polyfill": "^0.12.0"
  }
}
