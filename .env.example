GITHUB_TOKEN=
ANALYSIS_CONCURRENCY=2
BIND_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://octocount:octocount@postgres:5432/octocounts
# Size of the Postgres connection pool. Most handlers are a single short query,
# so this caps in-flight request concurrency; raise it if the database plan allows.
DATABASE_MAX_CONNECTIONS=10
# How long a request waits for a free connection before failing.
DATABASE_ACQUIRE_TIMEOUT_SECONDS=10
CLEANUP_INTERVAL_SECONDS=3600
JOB_RETENTION_COMPLETED_DAYS=1
JOB_RETENTION_STALE_HOURS=6
REPORT_MIN_RETENTION_DAYS=30
REPORT_MAX_ROWS=20000
REPORT_CLEANUP_BATCH_SIZE=1000

# How often the repo-history backfill task snapshots star counts, in seconds.
STAR_SNAPSHOT_INTERVAL_SECONDS=86400
# Total point budget for the SLOC-history backfill's age-tiered sampling
# (recent history daily, older history progressively coarser). The old
# SLOC_HISTORY_MAX_SAMPLES name is still honored as a fallback default.
SLOC_HISTORY_MAX_POINTS=24
# Wall-clock budget (seconds) for one SLOC backfill run; an exhausted budget
# leaves the backfill resumable rather than completed.
SLOC_BACKFILL_WALL_CLOCK_SECONDS=600
# How long an incomplete SLOC backfill must age (seconds) before a later view
# re-claims and resumes it. Auto-clamped above the wall-clock budget.
SLOC_BACKFILL_RECLAIM_AFTER_SECONDS=900
# How often the SLOC forward-sampling task refreshes today's point for repos
# whose backfill completed. Unchanged repos cost one cheap ref resolution.
SLOC_FORWARD_INTERVAL_SECONDS=86400
# How often aged SLOC snapshot points are compacted (weekly buckets inside a
# year, monthly beyond; first/last/min/max per bucket).
SLOC_COMPACTION_INTERVAL_SECONDS=86400
# GitHub OAuth app credentials for the browser extension's sign-in flow
# (backend/src/oauth.rs). Leave empty to disable extension OAuth.
GITHUB_EXTENSION_OAUTH_CLIENT_ID=
GITHUB_EXTENSION_OAUTH_CLIENT_SECRET=
# Trust X-Forwarded-For for rate-limit client IP. Set to 1/true only when a
# trusted reverse proxy fronts the service and overwrites (not appends to) the
# header; defaults to off.
TRUST_PROXY=false
# Token protecting the internal ops-stats endpoint (live job counts, cache hit
# ratio, uptime). Send it in the x-stats-token header. Empty (default) leaves
# the endpoint open; every field it exposes is non-sensitive.
INTERNAL_STATS_TOKEN=

# IndexNow submission for new/updated canonical report pages.
# The key file must be publicly reachable at https://<INDEXNOW_HOST>/<INDEXNOW_KEY>.txt.
# It is served by the Cloudflare Pages function (which reads the Pages-side INDEXNOW_KEY
# env var), NOT by this backend. Set the same INDEXNOW_KEY on both Cloudflare Pages and
# the backend.
#
# Local dev: leave INDEXNOW_KEY empty to keep submissions a no-op (the backend logs a
# warning and skips). Production: set INDEXNOW_ENABLED=true and INDEXNOW_KEY to a
# hex/alphanumeric token (8-128 characters), and set the same INDEXNOW_KEY on Cloudflare
# Pages so https://octocounts.com/<INDEXNOW_KEY>.txt returns the key.
INDEXNOW_ENABLED=true
INDEXNOW_KEY=
INDEXNOW_HOST=octocounts.com
# Optional; defaults to https://<INDEXNOW_HOST>/<INDEXNOW_KEY>.txt
INDEXNOW_KEY_LOCATION=
INDEXNOW_BATCH_SIZE=100
INDEXNOW_MAX_RETRIES=3
INDEXNOW_TIMEOUT_SECONDS=10
# Log submissions without sending HTTP requests (testing).
INDEXNOW_DRY_RUN=false
# Override the submission endpoint, e.g. to point at a mock server in tests.
# INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

VITE_API_BASE=http://127.0.0.1:8080
VITE_DEBUG_SHARE_PREVIEW=false
