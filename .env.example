GITHUB_TOKEN=
ANALYSIS_CONCURRENCY=2
BIND_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://octocount:octocount@postgres:5432/octocounts
# Size of the Postgres connection pool. Most handlers are a single short query,
# so this caps in-flight request concurrency; raise it if the database plan allows.
DATABASE_MAX_CONNECTIONS=10
# How long a request waits for a free connection before failing.
DATABASE_ACQUIRE_TIMEOUT_SECONDS=10
CLEANUP_INTERVAL_SECONDS=3600
JOB_RETENTION_COMPLETED_DAYS=1
JOB_RETENTION_STALE_HOURS=6
REPORT_MIN_RETENTION_DAYS=30
REPORT_MAX_ROWS=20000
REPORT_CLEANUP_BATCH_SIZE=1000

# IndexNow submission for new/updated canonical report pages.
# The key file must be publicly reachable at https://<INDEXNOW_HOST>/<INDEXNOW_KEY>.txt.
# It is served by the Cloudflare Pages function (which reads the Pages-side INDEXNOW_KEY
# env var), NOT by this backend. Set the same INDEXNOW_KEY on both Cloudflare Pages and
# the backend.
#
# Local dev: leave INDEXNOW_KEY empty to keep submissions a no-op (the backend logs a
# warning and skips). Production: set INDEXNOW_ENABLED=true and INDEXNOW_KEY to a
# hex/alphanumeric token (8-128 characters), and set the same INDEXNOW_KEY on Cloudflare
# Pages so https://octocounts.com/<INDEXNOW_KEY>.txt returns the key.
INDEXNOW_ENABLED=true
INDEXNOW_KEY=
INDEXNOW_HOST=octocounts.com
# Optional; defaults to https://<INDEXNOW_HOST>/<INDEXNOW_KEY>.txt
INDEXNOW_KEY_LOCATION=
INDEXNOW_BATCH_SIZE=100
INDEXNOW_MAX_RETRIES=3
INDEXNOW_TIMEOUT_SECONDS=10
# Log submissions without sending HTTP requests (testing).
INDEXNOW_DRY_RUN=false
# Override the submission endpoint, e.g. to point at a mock server in tests.
# INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

VITE_API_BASE=http://127.0.0.1:8080
VITE_DEBUG_SHARE_PREVIEW=false
