{
  "name": "octocount-web",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-fonts": "cp node_modules/@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2 public/fonts/jetbrains-mono-400-latin.woff2 && cp node_modules/@fontsource/jetbrains-mono/files/jetbrains-mono-latin-700-normal.woff2 public/fonts/jetbrains-mono-700-latin.woff2 && cp node_modules/@fontsource/jetbrains-mono/files/jetbrains-mono-latin-800-normal.woff2 public/fonts/jetbrains-mono-800-latin.woff2",
    "prebuild": "npm run copy-fonts",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build --manifest && node scripts/prerender-home.mjs",
    "test:seo": "npm run build && node --test tests/seo.test.mjs",
    "test:unit": "node --test tests/github-status.test.mjs tests/analytics.test.mjs tests/growth-*.test.mjs tests/deployment.test.mjs",
    "test:facts": "node ../scripts/check-product-facts.mjs",
    "test:csp": "node scripts/check-csp-hash.mjs",
    "test": "npm run test:csp && npm run test:unit && npm run test:facts && npm run test:seo && npm run test:budget",
    "preview": "vite preview --host 127.0.0.1",
    "test:budget": "node scripts/check-asset-budget.mjs",
    "test:qa": "playwright test"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "gifenc": "^1.0.3",
    "html-to-image": "^1.11.13",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "lucide-react": "^0.503.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "simple-icons": "^16.36.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.3",
    "vite": "^8.3.5"
  }
}
