{
  "name": "OctoCount",
  "short_name": "OctoCount",
  "description": "Count source lines for public GitHub repositories.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#151d1a",
  "theme_color": "#151d1a",
