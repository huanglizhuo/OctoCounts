# Vite hashed assets — browsers cache forever, no revalidation needed
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Early Hints: push preview images before HTML is fully sent
/
  Link: </octocounts-light-card.webp>; rel=preload; as=image; media="(prefers-color-scheme: light)"
  Link: </octocounts-dark-card.webp>; rel=preload; as=image; media="(prefers-color-scheme: dark)"

# Security headers for all routes
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https:; frame-ancestors 'none'
